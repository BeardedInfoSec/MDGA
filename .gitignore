# Environment variables (contains DB credentials)
.env

# Node
node_modules/

# User uploads
uploads/

# Dev/diagnostic scripts — many embed the SSH passphrase and prod
# credentials as literals, so the whole dir is ignored by default.
# NOTE: this rule only protects UNTRACKED files; git never auto-ignores
# already-tracked files. Before pasting any secret into a tools/ script,
# confirm `git check-ignore <file>` actually reports it as ignored.
# The shippable audit tool (no secrets) is explicitly un-ignored below.
tools/
!tools/mdga-audit/
!tools/mdga-audit/**

# Member audit data (PII / Discord IDs) — operational, not source.
MDGA_Audit_Log.xlsx

# Reconciliation exports carry the same member PII and land in the repo root
# with a timestamped name, so match the pattern rather than one filename.
mdga-reconciliation-*.xlsx

# Roster/recruitment spreadsheets pulled down from Drive — operational data.
google_docs/

# Local worktree state
.claude/

# Stray PNGs at the repo root (real assets live in images/)
/nemy.png
/MDGA.png
/MDGA_ballon.png
/MEGA_Logo.png
/icon.png
